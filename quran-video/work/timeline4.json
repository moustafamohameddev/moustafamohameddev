 "cards": [
  {
   "text": "وَلَا تَحْسَبَنَّ ٱللَّهَ غَٰفِلًا",
   "start": 0.0,
   "end": 5.3
  },
  {
   "text": "عَمَّا يَعْمَلُ ٱلظَّٰلِمُونَ ۚ",
   "start": 5.3,
   "end": 12.3
  },
  {
   "text": "إِنَّمَا يُؤَخِّرُهُمْ",
   "start": 12.7,
   "end": 16.85
  },
  {
   "text": "لِيَوْمٍۢ تَشْخَصُ فِيهِ ٱلْأَبْصَٰرُ ۝٤٢",
   "start": 16.85,
   "end": 23.14
  },
  {
   "text": "مُهْطِعِينَ مُقْنِعِى رُءُوسِهِمْ",
   "start": 23.68,
   "end": 27.15
  },
  {
   "text": "لَا يَرْتَدُّ إِلَيْهِمْ طَرْفُهُمْ ۖ",
   "start": 27.15,
   "end": 31.0
  },
  {
   "text": "وَأَفْـِٔدَتُهُمْ هَوَآءٌۭ ۝٤٣",
   "start": 31.0,
   "end": 36.34
  },
  {
   "text": "وَأَنذِرِ ٱلنَّاسَ يَوْمَ يَأْتِيهِمُ ٱلْعَذَابُ",
   "start": 36.72,
   "end": 43.2
  },
  {
   "text": "فَيَقُولُ ٱلَّذِينَ ظَلَمُوا۟ رَبَّنَآ",
   "start": 43.2,
   "end": 49.0
  },
  {
   "text": "أَخِّرْنَآ إِلَىٰٓ أَجَلٍۢ قَرِيبٍۢ",
   "start": 49.0,
   "end": 55.8
  },
  {
   "text": "نُّجِبْ دَعْوَتَكَ وَنَتَّبِعِ ٱلرُّسُلَ ۗ",
   "start": 55.8,
   "end": 59.84
  },
  {
   "text": "أَوَلَمْ تَكُونُوٓا۟ أَقْسَمْتُم مِّن قَبْلُ",
   "start": 60.34,
   "end": 68.0
  },
  {
   "text": "مَا لَكُم مِّن زَوَالٍۢ ۝٤٤",
   "start": 68.0,
   "end": 73.38
  },
  {
   "text": "وَسَكَنتُمْ فِى مَسَٰكِنِ ٱلَّذِينَ ظَلَمُوٓا۟ أَنفُسَهُمْ",
   "start": 73.92,
   "end": 82.94
  },
  {
   "text": "وَتَبَيَّنَ لَكُمْ كَيْفَ فَعَلْنَا بِهِمْ",
   "start": 83.44,
   "end": 88.4
  },
  {
   "text": "وَضَرَبْنَا لَكُمُ ٱلْأَمْثَالَ ۝٤٥",
   "start": 88.4,
   "end": 97.0
  }
 ]
}